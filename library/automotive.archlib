// Standard library v0.1 — loaded before every document.
// Templates define label, category, size, shape, icon and pins, never geometry.
// Shapes: rounded (default) | rect | circle | hexagon | cylinder
// Icons: file names from library/icons/

// ── Generic ──────────────────────────────────────────────────

define block {
    category generic
    size medium
}

define external_ecu {
    label "External ECU"
    shape rect
    icon ecu
    category external
    size medium
}

define software_component {
    label "SW Component"
    shape hexagon
    icon software
    category software
    size small
}

define connector {
    label "Connector"
    shape rect
    icon connector
    category external
    size small
}

// ── Power supply ─────────────────────────────────────────────

define power_source {
    label "Power Source"
    icon power
    category power
    size small
}

define battery extends power_source {
    label "Battery"
    icon battery
}

define fuse {
    label "Fuse"
    icon fuse
    category power
    size small
    left  { pin power IN }
    right { pin power OUT }
}

define relay {
    label "Relay"
    icon relay
    category power
    size small
    left  { pin power IN   pin digital COIL }
    right { pin power OUT }
}

define power_supply {
    label "Power Supply"
    icon regulator
    category power
    size medium
    left   { pin power VIN   pin digital EN }
    right  { pin power VOUT }
    bottom { pin ground GND }
}

define ldo extends power_supply {
    label "LDO"
}

define buck_converter extends power_supply {
    label "Buck Converter"
}

define boost_converter extends power_supply {
    label "Boost Converter"
}

define ground {
    label "GND"
    shape circle
    icon ground
    category power
    size small
    top { pin ground GND }
}

// ── Compute & memory ─────────────────────────────────────────

define microcontroller {
    label "MCU"
    icon chip
    category controller
    size large
}

define soc {
    label "SoC"
    icon soc
    category controller
    size large
}

define memory {
    label "Memory"
    shape cylinder
    icon memory
    category controller
    size small
    left { pin spi SPI }
}

define eeprom extends memory {
    label "EEPROM"
}

define flash extends memory {
    label "Flash"
}

define watchdog {
    label "Watchdog"
    icon watchdog
    category controller
    size small
    left  { pin digital WDI }
    right { pin digital RESET }
}

define oscillator {
    label "Oscillator"
    icon clock
    category controller
    size small
    right { pin signal CLK }
}

// ── Communication ────────────────────────────────────────────

define can_transceiver {
    label "CAN Transceiver"
    icon can
    category communication
    size medium
    left  { pin digital TXD   pin digital RXD   pin digital STB }
    right { pin can CANH   pin can CANL }
}

define lin_transceiver {
    label "LIN Transceiver"
    icon lin
    category communication
    size medium
    left  { pin digital TXD   pin digital RXD }
    right { pin lin LIN }
}

define ethernet_phy {
    label "Ethernet PHY"
    icon ethernet
    category communication
    size medium
    left  { pin bus MII }
    right { pin ethernet MDI }
}

define switch {
    label "Switch"
    icon switch
    category communication
    size medium
}

define bus {
    label "Bus"
    shape rect
    icon bus
    category communication
    size small
}

// ── Power stages & actuators ─────────────────────────────────

define high_side_driver {
    label "High Side Driver"
    icon driver
    category power
    size medium
    left   { pin power VS   pin digital IN }
    right  { pin power OUT }
    bottom { pin analog IS   pin ground GND }
}

define half_bridge {
    label "Half Bridge"
    icon bridge
    category power
    size medium
    left   { pin power VS   pin digital IN }
    right  { pin power OUT }
    bottom { pin analog IS   pin ground GND }
}

define full_bridge {
    label "Full Bridge"
    icon bridge
    category power
    size medium
    left   { pin power VS   pin digital IN1   pin digital IN2 }
    right  { pin power OUT1   pin power OUT2 }
    bottom { pin analog IS   pin ground GND }
}

define actuator {
    label "Actuator"
    category actuator
    size small
}

define load extends actuator {
    label "Load"
    icon lamp
}

define motor extends actuator {
    label "Motor"
    shape circle
    icon motor
}

define valve extends actuator {
    label "Valve"
    icon valve
}

// ── Sensing ──────────────────────────────────────────────────

define sensor {
    label "Sensor"
    shape circle
    icon sensor
    category sensor
    size small
}
